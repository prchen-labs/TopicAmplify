<!DOCTYPE html>
<html>
  <head>
    <title>Search Results</title>
  </head>
  <body>
    <h1>Search Results:</h1>
    <% if (results.length > 0) { %>
      <% results.forEach(result => { %>
        <p><%= result.text %> - <%= result.author %> - <%= result.date %></p>
      <% }); %>
    <% } else { %>
      <p>No results found.</p>
    <% } %>
  </body>
</html>