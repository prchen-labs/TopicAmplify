<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= activity.title %></title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="/activity.css" type="text/css" rel="stylesheet">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js"></script>
    <script src="/activity.js" type="text/javascript"></script>
</head>
<body>
    <div id="header">
        <a class="left-content col-4 col-s-3" href="#">
            <img src="./loud-speaker.png"/>
            <div style="padding-left:25px">活動大聲公</div>
        </a> 
        <div class=" center-content col-8 col-s-6">
            <div id="back" class="material-icons icon">arrow_back</div>
            <div style="padding-left:20px"><%= activity.title %></div>
        </div>
        <div class="right-content col-2 col-s-3">
            <a class="material-icons icon" href="./log.ejs">account_circle</a>
        </div>
    </div>
    <div id="content" class="col-9">
        <div class="col-12">
            <img src="<%= activity.image %>" class="activity-image" />
            <div class="activity-detail">
                <h1><%= activity.title %></h1>
                <p><%= activity.date %></p>
                <p><%= activity.content %></p>
            </div>
        </div>
    </div>
    <div id="sidebar" class="col-3 col-s-12">
        <div id="select_bar">
            <button id="reset" style="width:50%">重置</button>
            <button id="filte" style="width:50%">篩選</button>
        </div>
    </div>
</body>
</html>
