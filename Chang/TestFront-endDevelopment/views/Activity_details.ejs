<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>活動大聲公</title>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="/rwd.css" type="text/css" rel="stylesheet">
    <script src="/main.js" type="text/javascript"></script>
 
</head>

<body>
    
    <div id="header">
        <a class="left-content col-4 col-s-3" href="#">
            <img src="./loud-speaker.png"/>
            <div style="padding-left:25px">活動大聲公</div>
        </a> 
        <div class=" center-content col-8 col-s-6">
            <div id="back" class="material-icons icon">arrow_back</div>
            <input id="search-box" class="in" type="text" name="keyword" />
            <div id="search-button" class="material-icons icon" type="button">search</div>
    
        </div>
            <div class="right-content col-2 col-s-3">
                <a class="material-icons icon" href="./log.ejs">account_circle</a>
            </div>  
        </div>
    <div class="col-12 topnav">
        <div style="float:left;width:calc(100% - 39px)">
            <a class="toplink" a href="#">實習</a>
            <a class="toplink" a href="#">體育</a>
            <a class="toplink" a href="#">志工</a>
        </div>
        <div style="float:right;width:39px">
            <a id="side_menu" class="material-icons" style="font-size:36px">menu</a>
        </div>
    </div>
    <div id="content" class="col-9">
        <h1>最新活動</h1>
        <div class="col-12">            
            <% for (const tit of searches) { %>
                <div class="col-12">
                    <p class="col-4 title"><%= tit.title %></p>
                    <p class="col-6 summary"><%- tit.content %></p>
                    <p class="col-2 time"><%= tit.time %></p>
                </div>
            <% } %>           
        </div>
        
        <h1>熱門活動</h1>
        <div class="col-12">            
            <% for (const tit of searches) { %>
                <div class="col-12">
                    <p class="col-4 title"><%= tit.title %></p>
                    <p class="col-6 summary"><%- tit.content %></p>
                    <p class="col-2 time"><%= tit.time %></p>
                </div>
            <% } %>           
        </div>
        
    </div>
    <div id="sidebar" class="col-3 col-s-12">
        <div id="select_bar">
            <button id="reset" style="width:50%">重置</button>
            <button id="filte" style="width:50%">篩選</button>
        </div>
    </div>
    
</body>
</html>
