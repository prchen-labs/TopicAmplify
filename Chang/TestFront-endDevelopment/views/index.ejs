<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>活動大聲公</title>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="/rwd.css" type="text/css" rel="stylesheet">
    <script src="/main.js" type="text/javascript"></script> 
    <script src="/pagination.js"></script>
<!--     <script src="/login-logout.js" type="text/javascript"></script>  -->
<!--     <script src="/js/login-logout.js"></script> -->
</head>
<body>
    <%- include('partials/header.ejs') %>

    <div id="content" class="col-9">
        <ul class="activity-list">
            <% for (const tit of searches) { %>
                <li class="activity">
                    <div class="activity-image">
                        <% 
            let example_url=["https://handheart.com.tw/wp-content/uploads/2018/08/170327-%E6%AD%8C%E5%94%B1%E6%AF%94%E8%B3%BD-02-e1546486281695.jpg","https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRAv8RVvMGB99NQMHzQIuh0EgPBhTDcdpYkXEpv2fQPqA&s","https://thumb.photo-ac.com/98/9829d73d30e7c23be57f889e24531136_t.jpeg","/loud-speaker.png"];
            let randomIndex = Math.floor(Math.random() * example_url.length);
            %>
                        <img src="<%=example_url[randomIndex];%>"/>
<!--                         <img src="<%= tit.img %>"/> -->
                    </div>
                    <div class="activity-info">
                        <a class="activity-title" href="/activity/<%= tit._id %>"><%= tit.title %></a>                    
                        <p class="activity-summary"><%- tit.content %></p>
<!--                          <p class="activity-time"><%= tit.time %></p> -->
                        <a class="activity-url" href="<%= tit.url %>">前往官網</a>
                    </div>
                </li>
            <% } %>           
        </ul>
<!--         <div id="pagination"></div> -->
<!--         <script>
      window.onload = function () {
        createPagination();
      };
    </script> -->
    </div>
<!--     <div id="pagination"></div> -->
</body>
</html>